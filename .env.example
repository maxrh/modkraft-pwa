# Canonical site URL (defaults to https://fotoarkiv.modkraft.dk in astro.config.mjs)
# Override only for staging / preview builds:
# PUBLIC_SITE=https://modkraft-pwa.max-5ba.workers.dev

# Sanity (optional — leave empty until you create a project at https://www.sanity.io/manage)
# When PUBLIC_SANITY_PROJECT_ID is set, Studio is available at /admin
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production
PUBLIC_SANITY_API_VERSION=2025-10-01

# Optional read token for private datasets / draft content
# SANITY_API_READ_TOKEN=
