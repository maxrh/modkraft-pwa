  "images": [
    {
      "id": "01",
      "sortOrder": 1,
      "filename": "01-dsc-8635-0.jpg",
      "originalFilename": "DSC_8635_0.jpg",
      "width": 940,
      "height": 696,
      "credit": "Ole Garde",
      "caption": "En gruppe på omkring 60 syrere bliver guidet til Stop'n Sleep Hotel i Rødby Havn. Politiet eskorterer gruppen i ro og mag. Men i gruppen er der forvirring. Størstedelen vil videre til Sverige. Men da det går op for dem, at de risikerer at få taget fingeraftryk og påbegyndt en asylsag i Danmark, vil de hellere tilbage til Tyskland igen.",
      "captionSource": "title",
      "sourceResolve": "relative",
      "tags": [
        "Asyl",
        "Flygtninge",
        "Malmø",
        "Refugees Welcome",
        "Rødby",
        "Syrien"
      ]
    },
    {
      "id": "02",
      "sortOrder": 2,
      "filename": "02-dsc-8656.jpg",
      "originalFilename": "DSC_8656.jpg",
      "width": 940,
      "height": 655,
      "credit": "Ole Garde",
      "caption": "Gruppen er rejst gennem gennem Tyrkiet, Grækenland, Makedonien, Serbien, Ungarn Østrig og Tyskland. De vil søge asyl i Sverige, ikke i Danmark. \"Jeg vil hellere fængsles end afgive fingeraftryk. I Danmark er det svært at få statsborgerskab. Og giver vi fingeraftryk, bliver det svært at komme ind i Sverige, hvor vi har familie,\" siger en kvinde. I Østrig og Tyskland har det fået valget mellem at afgive fingeraftryk eller tage videre, fortæller hun.",
      "captionSource": "title",
      "sourceResolve": "relative",
      "tags": [
        "Asyl",
        "Flygtninge",
        "Malmø",
        "Refugees Welcome",
        "Rødby",
        "Syrien"
      ]
    },
    {
      "id": "03",
      "sortOrder": 3,
      "filename": "03-dsc-8672.jpg",
      "originalFilename": "DSC_8672.jpg",
      "width": 940,
      "height": 667,
      "credit": "Ole Garde",
      "caption": "Ingen i gruppen ønsker at søge asyl i Danmark. Politiet oplyser, at gruppen kan nøjes med at opgive deres navn og give besked om, hvor de ønsker at søge asyl - og dermed slippe for at afgive fingeraftryk. Den løsning viser sig ikke holdbar, og gruppen ender med at sive væk, da politiet flytter fokus med en anden gruppe af flygtninge, som ankommer med toget i Rødby Havn. Syrerne forsøger at finde en lokal bus til Maribo. Derfra vil de køre med tog til København og videre til Sverige.",
      "captionSource": "title",
      "sourceResolve": "relative",
      "tags": [
        "Asyl",
        "Flygtninge",
        "Malmø",
        "Maribo",
        "Refugees Welcome",
        "Rødby",
        "Syrien"
      ]
    },
    {
      "id": "04",
      "sortOrder": 4,
      "filename": "04-dsc-8854.jpg",
      "originalFilename": "DSC_8854.jpg",
      "width": 627,
      "height": 939,
      "credit": "Ole Garde",
      "caption": "\"Vi vil bare tilbage til Tyskland nu. Vi har tilbagelagt tusindvis af kilometer. Jeg kender én, der har betalt 20.000 euro for at komme hertil. Jeg betalte 1500 dollars og omkring 700 euro. Jeg er heldig, at jeg har betalt mindre. Vi håber, at politiet lader os gå til Sverige eller lader os tage tilbage til Tyskland. Det er et problem, hvis vi får taget fingeraftryk. Vi er bekymrede for regeringen her. Vi har fået at vide, at den er imod flygtninge. Og hvis vi afgiver fingeraftryk, skal vi blive i landet,\" fortæller denne 28-årige ingeniør.",
      "captionSource": "title",
      "sourceResolve": "relative",
      "tags": [
        "Asyl",
        "Flygtninge",
        "Malmø",
        "Refugees Welcome",
        "Rødby",
