---
import { ClientRouter } from 'astro:transitions';
import { SITE_TITLE } from '@/lib/site';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  jsonLd?: Record<string, unknown>;
}

const { title, description, canonical, image, imageAlt, jsonLd } = Astro.props;
const pageTitle = title === SITE_TITLE ? title : `${title} · ${SITE_TITLE}`;
const jsonLdHtml = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : '';
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="description" content={description} />
{canonical && <link rel="canonical" href={canonical} />}
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content={image ? 'article' : 'website'} />
<meta property="og:locale" content="da_DK" />
{canonical && <meta property="og:url" content={canonical} />}
{
  image && (
    <>
      <meta property="og:image" content={image} />
      <meta property="og:image:alt" content={imageAlt || title} />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:image" content={image} />
    </>
  )
}
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,200..800&display=swap"
  rel="stylesheet"
/>
<title>{pageTitle}</title>
{jsonLdHtml && <script type="application/ld+json" set:html={jsonLdHtml} />}
<ClientRouter fallback="swap" />
<style>
  /* Hide until revealed — set at start of mosaic init / after client navigations. */
  [data-mosaic-root]:not([data-revealed]) [data-mosaic] {
    visibility: hidden;
  }
</style>
<noscript>
  <style>
    [data-mosaic-root] [data-mosaic] { visibility: visible !important; }
  </style>
</noscript>
