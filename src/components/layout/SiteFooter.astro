---
import { getCollection } from 'astro:content';
import { getArchiveStats } from '@/lib/photos';
import Container from './Container.astro';

const stats = await getArchiveStats();
const series = await getCollection('photoSeries');
const photoCount = stats.photoCount.toLocaleString('da-DK');
const collectionCount = stats.collectionCount.toLocaleString('da-DK');
---

<footer class="mt-16 border-t border-border/70" transition:animate="none">
  <Container class="py-8 text-sm text-muted-foreground">
    <p>
      Modkraft Fotoarkiv — {photoCount} dokumentariske fotografier fra {collectionCount} fotoserier og
      fotoblogs (2012–2017).
    </p>
    <nav class="mt-3 flex flex-wrap gap-x-4 gap-y-1" aria-label="Arkivnavigation">
      <a href="/" class="text-foreground underline-offset-2 hover:underline">Alle fotos</a>
      <a href="/fotoserie" class="text-foreground underline-offset-2 hover:underline">Fotoserier</a>
      {
        series.map((s) => (
          <a
            href={`/fotoblog/${s.data.id}`}
            class="text-foreground underline-offset-2 hover:underline"
          >
            Fotoblog: {s.data.title}
          </a>
        ))
      }
      {
        import.meta.env.DEV && (
          <a href="/match" class="text-foreground underline-offset-2 hover:underline">
            Match (local)
          </a>
        )
      }
    </nav>
  </Container>
</footer>
