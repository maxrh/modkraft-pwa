---
import { tagHref } from '@/lib/photos';

interface Props {
  tags: string[];
  class?: string;
}

const { tags, class: className } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class:list={['flex flex-wrap gap-2', className]}>
      {tags.map((tag) => (
        <li>
          <a
            href={tagHref(tag)}
            class="inline-block rounded-full border border-border bg-background px-3 py-1 text-xs font-medium text-muted-foreground no-underline hover:border-foreground/40 hover:text-foreground"
          >
            {tag}
          </a>
        </li>
      ))}
    </ul>
  )
}
