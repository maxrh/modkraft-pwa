---
import { badgeVariants } from '@/components/ui/badge';
import { cn } from '@/lib/utils';
import { tagHref } from '@/lib/photos';

interface Props {
  tags: string[];
  class?: string;
}

const { tags, class: className } = Astro.props;
---

{
  tags.length > 0 && (
    <ul class:list={['flex flex-wrap gap-2', className]}>
      {tags.map((tag) => (
        <li>
          <a
            href={tagHref(tag)}
            class={cn(
              badgeVariants({ variant: 'muted' }),
              'no-underline hover:bg-muted/80 hover:text-foreground',
            )}
          >
            {tag}
          </a>
        </li>
      ))}
    </ul>
  )
}
