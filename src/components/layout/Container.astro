---
interface Props {
  /** Uncapped width (keeps gutters). Default caps at --content-max. */
  size?: 'full';
  class?: string;
}

const { size, class: className } = Astro.props;
const maxWidth = size === 'full' ? undefined : 'max-w-[var(--content-max)]';
---

<div class:list={['mx-auto px-4 sm:px-6', maxWidth, className]}>
  <slot />
</div>
