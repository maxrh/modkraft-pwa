---
import type { MosaicView } from '@/components/ViewMenu';
import ContentHero from './ContentHero.astro';
import MosaicToolbar from './MosaicToolbar.astro';

interface Props {
  title: string;
  description?: string;
  kicker?: string | null;
  meta?: string | null;
  count: number;
  seriesCount: number;
  showView?: boolean;
  defaultView?: MosaicView;
}

const {
  title,
  description,
  kicker = null,
  meta = null,
  count,
  seriesCount,
  showView = false,
  defaultView = 'photos',
} = Astro.props;
---

<header class="mb-4 flex min-h-64 flex-col">
  <ContentHero title={title} description={description} kicker={kicker} meta={meta} />
  <MosaicToolbar
    count={count}
    seriesCount={seriesCount}
    showView={showView}
    defaultView={defaultView}
  />
</header>
