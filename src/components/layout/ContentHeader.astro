---
import SortMenu, { SortLabel } from '@/components/SortMenu';

interface Props {
  title: string;
  description?: string;
  count: number;
  seriesCount: number;
}

const { title, description, count, seriesCount } = Astro.props;
const countLabel = `${count.toLocaleString('da-DK')} ${count === 1 ? 'foto' : 'fotos'} fra ${seriesCount.toLocaleString('da-DK')} ${seriesCount === 1 ? 'fotoserie' : 'fotoserier'}`;
---

<header class="mb-4 flex min-h-64 flex-col">
  <div class="flex flex-1 flex-col items-center justify-center px-4 py-10 text-center">
    <h1 class="font-display text-3xl font-extrabold tracking-tight sm:text-8xl/20">{title}</h1>
    {
      description && (
        <p class="mt-6 max-w-3xl text-xl leading-tight text-muted-foreground">{description}</p>
      )
    }
  </div>
  <div class="flex h-9 shrink-0 items-center justify-between gap-4">
    <p class="text-sm text-muted-foreground tabular-nums">{countLabel}</p>
    <div class="flex items-center gap-4">
      <p class="text-sm text-muted-foreground">
        <SortLabel client:only="react" />
      </p>
      <SortMenu client:only="react" />
    </div>
  </div>
</header>
