---
import type { Photo } from '@/lib/photos';
import { packIntoColumns } from '@/lib/photos';
import PhotoCard from '@/components/PhotoCard.astro';

interface Props {
  photos: Photo[];
  /** Client-side shuffle / alpha / date. Skips SSR cards and ships one JSON list. */
  sortable?: boolean;
}

const { photos, sortable = false } = Astro.props;

const INITIAL_COUNT = 48;
const BATCH_SIZE = 48;
const ssrColumnCount = 3;

function cardPayload(photo: Photo) {
  return {
    href: photo.href,
    thumb: photo.thumb,
    width: photo.width,
    height: photo.height,
    caption: photo.caption,
    collectionTitle: photo.collectionTitle,
    sortOrder: photo.sortOrder,
    imageCount: photo.imageCount,
    credit: photo.credit,
    publishedAt: photo.publishedAt,
  };
}

const initialPhotos = sortable ? [] : photos.slice(0, INITIAL_COUNT);
const restPhotos = sortable ? [] : photos.slice(INITIAL_COUNT);
const ssrColumns = packIntoColumns(initialPhotos, ssrColumnCount);
const indexById = new Map(initialPhotos.map((photo, index) => [photo.id, index]));

/** Compact payload for client-side card construction (mirrors PhotoCard fields). */
const restPayload = restPhotos.map(cardPayload);
const allPayload = sortable ? photos.map(cardPayload) : [];

// Prevent </script> in captions from breaking the inline JSON payload.
const restJson = JSON.stringify(restPayload).replace(/</g, '\\u003c');
const allJson = JSON.stringify(allPayload).replace(/</g, '\\u003c');
const templatePhoto = photos[0];
---

<div
  data-mosaic-root
  data-sortable={sortable ? '' : undefined}
  data-batch-size={String(BATCH_SIZE)}
  data-initial-count={String(INITIAL_COUNT)}
  data-total={String(photos.length)}
>
  <div
    data-mosaic
    data-ssr-cols={sortable ? '0' : String(ssrColumnCount)}
    class="grid grid-cols-2 items-start gap-4 lg:grid-cols-3"
  >
    {
      ssrColumns.map((column) => (
        <div class="flex min-w-0 flex-col gap-4" data-mosaic-col>
          {column.map((photo) => {
            const globalIndex = indexById.get(photo.id) ?? 0;
            return (
              <div
                data-index={String(globalIndex)}
                data-ratio={(photo.height / photo.width).toFixed(4)}
                class="min-w-0"
              >
                <PhotoCard photo={photo} highPriority={globalIndex < 2} />
              </div>
            );
          })}
        </div>
      ))
    }
  </div>

  {
    sortable && templatePhoto && (
      <>
        <script type="application/json" data-mosaic-all set:html={allJson} />
        <template data-card-template>
          <PhotoCard photo={templatePhoto} />
        </template>
      </>
    )
  }
  {
    !sortable && restPayload.length > 0 && (
      <>
        <script type="application/json" data-mosaic-rest set:html={restJson} />
        <template data-card-template>
          <PhotoCard photo={restPhotos[0]} />
        </template>
      </>
    )
  }
  {
    ((sortable && photos.length > INITIAL_COUNT) || (!sortable && restPayload.length > 0)) && (
      <div data-mosaic-more class="mt-8 flex flex-col items-center gap-3">
        <button
          type="button"
          data-mosaic-load
          class="rounded-md border border-border bg-background px-4 py-2 text-sm font-medium text-foreground hover:bg-accent"
        >
          Vis flere fotos
        </button>
        <div data-mosaic-sentinel class="h-px w-full" aria-hidden="true" />
      </div>
    )
  }
</div>

<script is:inline data-astro-rerun>
  (function () {
    // View transitions can re-run this without a currentScript; init every new mosaic root.
    var roots = document.querySelectorAll('[data-mosaic-root]:not([data-ready])');
    for (var r = 0; r < roots.length; r++) initMosaic(roots[r]);

    function initMosaic(root) {
    if (!root || root.hasAttribute('data-ready')) return;
    root.setAttribute('data-ready', '');

    var GAP = 16;
    var mosaic = root.querySelector('[data-mosaic]');
    if (!mosaic) return;

    var sortable = root.hasAttribute('data-sortable');
    var ssrCols = Number(mosaic.getAttribute('data-ssr-cols') || 3);
    var batchSize = Number(root.getAttribute('data-batch-size') || 48);
    var initialCount = Number(root.getAttribute('data-initial-count') || 48);
    if (!sortable) {
      // Show SSR columns immediately; packing below may still reflow breakpoints.
      root.setAttribute('data-revealed', '');
    }
    var queries = [window.matchMedia('(min-width: 64rem)')];
    var current = 0;
    var heights = [];
    var rest = [];
    var allPhotos = [];
    var nextIndex = initialCount;
    var observer = null;

    var restScript = root.querySelector('[data-mosaic-rest]');
    if (restScript && restScript.textContent) {
      try {
        rest = JSON.parse(restScript.textContent);
      } catch (e) {
        rest = [];
      }
    }

    var allScript = root.querySelector('[data-mosaic-all]');
    if (allScript && allScript.textContent) {
      try {
        allPhotos = JSON.parse(allScript.textContent);
      } catch (e) {
        allPhotos = [];
      }
    }

    var moreEl = root.querySelector('[data-mosaic-more]');
    var loadBtn = root.querySelector('[data-mosaic-load]');
    var sentinel = root.querySelector('[data-mosaic-sentinel]');

    function columnCount() {
      return queries[0].matches ? 3 : 2;
    }

    function getColumns() {
      return Array.prototype.slice.call(mosaic.querySelectorAll('[data-mosaic-col]'));
    }

    function collectItemsSorted() {
      var items = [];
      var cols = getColumns();
      for (var i = 0; i < cols.length; i++) {
        var kids = cols[i].children;
        for (var j = 0; j < kids.length; j++) items.push(kids[j]);
      }
      items.sort(function (a, b) {
        return Number(a.getAttribute('data-index') || 0) - Number(b.getAttribute('data-index') || 0);
      });
      return items;
    }

    function recomputeHeights(columns) {
      heights = [];
      for (var c = 0; c < columns.length; c++) {
        var h = 0;
        var kids = columns[c].children;
        for (var i = 0; i < kids.length; i++) {
          h += parseFloat(kids[i].getAttribute('data-ratio')) || 1;
        }
        heights.push(h);
      }
    }

    function markHighPriority(columns) {
      var marked = 0;
      for (var c = 0; c < columns.length; c++) {
        var imgs = columns[c].querySelectorAll('img');
        for (var i = 0; i < imgs.length; i++) {
          if (marked < 2 && i === 0) {
            imgs[i].setAttribute('fetchpriority', 'high');
            imgs[i].setAttribute('loading', 'eager');
            marked++;
          } else {
            imgs[i].removeAttribute('fetchpriority');
            imgs[i].setAttribute('loading', 'lazy');
          }
        }
      }
    }

    function pack(n) {
      var items = collectItemsSorted();
      var columns = [];
      heights = [];
      for (var c = 0; c < n; c++) {
        var col = document.createElement('div');
        col.setAttribute('data-mosaic-col', '');
        col.style.cssText = 'display:flex;flex-direction:column;gap:' + GAP + 'px;min-width:0';
        columns.push(col);
        heights.push(0);
      }

      for (var i = 0; i < items.length; i++) {
        var shortest = 0;
        for (var k = 1; k < n; k++) if (heights[k] < heights[shortest]) shortest = k;
        columns[shortest].appendChild(items[i]);
        heights[shortest] += parseFloat(items[i].getAttribute('data-ratio')) || 1;
      }

      mosaic.style.gridTemplateColumns = 'repeat(' + n + ', minmax(0, 1fr))';
      mosaic.replaceChildren.apply(mosaic, columns);
      markHighPriority(columns);
    }

    var cardTemplateEl = root.querySelector('[data-card-template]');
    var cardPrototype =
      cardTemplateEl && cardTemplateEl.content
        ? cardTemplateEl.content.firstElementChild
        : null;

    function buildCard(photo, globalIndex) {
      var ratio = (photo.height / photo.width).toFixed(4);
      var wrap = document.createElement('div');
      wrap.setAttribute('data-index', String(globalIndex));
      wrap.setAttribute('data-ratio', ratio);
      wrap.className = 'min-w-0';

      if (!cardPrototype) return wrap;

      var card = cardPrototype.cloneNode(true);
      var link = card.matches('[data-card-link]')
        ? card
        : card.querySelector('[data-card-link]');
      var img = card.querySelector('[data-card-img]');
      var count = card.querySelector('[data-card-count]');
      var title = card.querySelector('[data-card-title]');
      var creditRow = card.querySelector('[data-card-credit-row]');
      var credit = card.querySelector('[data-card-credit]');

      if (link) {
        link.setAttribute('href', photo.href);
        link.style.aspectRatio = photo.width + ' / ' + photo.height;
      }

      if (img) {
        img.setAttribute('src', photo.thumb);
        img.setAttribute(
          'alt',
          photo.caption ||
            photo.collectionTitle + ' (' + photo.sortOrder + '/' + photo.imageCount + ')',
        );
        img.setAttribute('width', String(photo.width));
        img.setAttribute('height', String(photo.height));
        img.setAttribute('loading', 'lazy');
        img.removeAttribute('fetchpriority');
      }

      if (count) count.textContent = photo.sortOrder + '/' + photo.imageCount;
      if (title) title.textContent = photo.collectionTitle;

      if (creditRow && credit) {
        if (photo.credit) {
          credit.textContent = photo.credit;
          creditRow.hidden = false;
        } else {
          credit.textContent = '';
          creditRow.hidden = true;
        }
      }

      wrap.appendChild(card);
      return wrap;
    }

    function appendBatch() {
      if (!rest.length) {
        cleanupMore();
        return;
      }

      var columns = getColumns();
      if (!columns.length || heights.length !== columns.length) {
        recomputeHeights(columns);
      }

      var batch = rest.splice(0, batchSize);
      for (var i = 0; i < batch.length; i++) {
        var shortest = 0;
        for (var k = 1; k < columns.length; k++) {
          if (heights[k] < heights[shortest]) shortest = k;
        }
        var card = buildCard(batch[i], nextIndex++);
        columns[shortest].appendChild(card);
        heights[shortest] += parseFloat(card.getAttribute('data-ratio')) || 1;
      }

      if (!rest.length) cleanupMore();
      else if (loadBtn) {
        loadBtn.textContent = 'Vis flere fotos (' + rest.length + ' tilbage)';
      }
    }

    function cleanupMore() {
      if (observer && sentinel) observer.unobserve(sentinel);
      if (sortable) {
        if (moreEl) moreEl.hidden = true;
        return;
      }
      if (moreEl) moreEl.remove();
      if (restScript) restScript.remove();
      if (cardTemplateEl) cardTemplateEl.remove();
    }

    function readSortToken() {
      try {
        var token = sessionStorage.getItem('mosaic-sort');
        if (token === 'shuffle' || token === 'alpha' || token === 'date') return token;
        if (token === 'alpha:asc' || token === 'alpha:desc' || token === 'date:asc' || token === 'date:desc') {
          return token;
        }
      } catch (e) {}
      return 'shuffle';
    }

    function orderPhotos(list, token) {
      var copy = list.slice();
      var desc = token === 'alpha:desc' || token === 'date' || token === 'date:desc';
      var sign = desc ? -1 : 1;
      if (token === 'alpha' || token === 'alpha:asc' || token === 'alpha:desc') {
        copy.sort(function (a, b) {
          var title = String(a.collectionTitle || '').localeCompare(
            String(b.collectionTitle || ''),
            'da',
          );
          if (title) return title * sign;
          return ((a.sortOrder || 0) - (b.sortOrder || 0)) * sign;
        });
      } else if (token === 'date' || token === 'date:asc' || token === 'date:desc') {
        copy.sort(function (a, b) {
          var date = String(a.publishedAt || '').localeCompare(String(b.publishedAt || ''));
          if (date) return date * sign;
          return ((a.sortOrder || 0) - (b.sortOrder || 0)) * sign;
        });
      } else {
        for (var i = copy.length - 1; i > 0; i--) {
          var j = Math.floor(Math.random() * (i + 1));
          var tmp = copy[i];
          copy[i] = copy[j];
          copy[j] = tmp;
        }
      }
      return copy;
    }

    function syncMore() {
      if (!moreEl) return;
      if (rest.length) {
        moreEl.hidden = false;
        if (loadBtn) loadBtn.textContent = 'Vis flere fotos (' + rest.length + ' tilbage)';
        if (observer && sentinel) observer.observe(sentinel);
      } else {
        moreEl.hidden = true;
        if (observer && sentinel) observer.unobserve(sentinel);
      }
    }

    function renderSorted(token) {
      if (
        token !== 'shuffle' &&
        token !== 'alpha' &&
        token !== 'date' &&
        token !== 'alpha:asc' &&
        token !== 'alpha:desc' &&
        token !== 'date:asc' &&
        token !== 'date:desc'
      ) {
        token = 'shuffle';
      }
      try {
        sessionStorage.setItem('mosaic-sort', token);
      } catch (e) {}
      var ordered = orderPhotos(allPhotos, token);
      var n = columnCount();
      var initial = ordered.slice(0, initialCount);
      rest = ordered.slice(initialCount);
      nextIndex = 0;

      var holder = document.createElement('div');
      holder.setAttribute('data-mosaic-col', '');
      for (var i = 0; i < initial.length; i++) {
        holder.appendChild(buildCard(initial[i], nextIndex++));
      }
      mosaic.replaceChildren(holder);
      current = 0;
      pack(n);
      current = n;
      syncMore();
      root.setAttribute('data-revealed', '');
    }

    function layout() {
      var n = columnCount();
      if (n === current) return;

      // First paint: viewport matches SSR — keep DOM, just sync heights.
      if (n === ssrCols && current === 0) {
        current = n;
        mosaic.style.gridTemplateColumns = 'repeat(' + n + ', minmax(0, 1fr))';
        recomputeHeights(getColumns());
        markHighPriority(getColumns());
        return;
      }

      current = n;
      pack(n);
    }

    if (sortable) {
      renderSorted(readSortToken());
      root._renderSorted = renderSorted;
      if (!window.__mosaicSortBound) {
        window.__mosaicSortBound = true;
        window.addEventListener('mosaic:sort', function (event) {
          var mode = event && event.detail;
          var roots = document.querySelectorAll('[data-mosaic-root][data-sortable]');
          for (var i = 0; i < roots.length; i++) {
            if (typeof roots[i]._renderSorted === 'function') roots[i]._renderSorted(mode);
          }
        });
      }
    } else {
      layout();
    }
    queries.forEach(function (q) {
      q.addEventListener('change', layout);
    });

    if (loadBtn) {
      loadBtn.addEventListener('click', function () {
        appendBatch();
      });
      if (rest.length) {
        loadBtn.textContent = 'Vis flere fotos (' + rest.length + ' tilbage)';
      }
    }

    if (sentinel && 'IntersectionObserver' in window) {
      observer = new IntersectionObserver(
        function (entries) {
          for (var i = 0; i < entries.length; i++) {
            if (entries[i].isIntersecting) appendBatch();
          }
        },
        { rootMargin: '600px 0px' }
      );
      observer.observe(sentinel);
    }
    } // initMosaic
  })();
</script>
