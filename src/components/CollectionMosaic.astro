---
import type { CollectionCardData } from '@/lib/photos';
import { packIntoColumns } from '@/lib/photos';
import MosaicCard from '@/components/MosaicCard.astro';

interface Props {
  collections: CollectionCardData[];
  /** Client-side shuffle / alpha / date. Skips SSR cards and ships one JSON list. */
  sortable?: boolean;
  /** Initial sort token when storage is empty or persistSort is false. */
  defaultSort?: string;
  /** Write sort choices to sessionStorage (off on fotoblog). */
  persistSort?: boolean;
  class?: string;
}

const {
  collections,
  sortable = false,
  defaultSort = 'shuffle',
  persistSort = true,
  class: className,
} = Astro.props;

const ssrColumnCount = 3;
const ssrColumns = sortable ? [] : packIntoColumns(collections, ssrColumnCount);
const allJson = JSON.stringify(collections).replace(/</g, '\\u003c');
const template = collections[0];
---

<div
  data-collection-mosaic
  data-sortable={sortable ? '' : undefined}
  data-default-sort={defaultSort}
  data-persist-sort={persistSort ? undefined : 'false'}
  class:list={[className]}
>
  <div
    data-collection-grid
    data-ssr-cols={sortable ? '0' : String(ssrColumnCount)}
    class="grid grid-cols-2 items-start gap-4 lg:grid-cols-3"
  >
    {
      ssrColumns.map((column) => (
        <div class="flex min-w-0 flex-col gap-4" data-collection-col>
          {column.map((item, index) => (
            <div
              data-ratio={(item.height / item.width).toFixed(4)}
              class="min-w-0"
            >
              <MosaicCard
                href={item.href}
                thumb={item.thumb}
                width={item.width}
                height={item.height}
                alt={item.alt}
                title={item.title}
                badge={item.badge}
                meta={item.meta}
                overlay="always"
                highPriority={index < 2}
              />
            </div>
          ))}
        </div>
      ))
    }
  </div>

  {
    sortable && template && (
      <>
        <script type="application/json" data-collection-all set:html={allJson} />
        <template data-collection-card-template>
          <MosaicCard
            href={template.href}
            thumb={template.thumb}
            width={template.width}
            height={template.height}
            alt={template.alt}
            title={template.title}
            badge={template.badge}
            meta={template.meta}
            overlay="always"
          />
        </template>
      </>
    )
  }
</div>

<script is:inline data-astro-rerun>
  (function () {
    var GAP = 16;

    function columnCount() {
      return window.matchMedia('(min-width: 64rem)').matches ? 3 : 2;
    }

    function reflowStatic(root) {
      if (root.getAttribute('data-ready') != null) return;
      root.setAttribute('data-ready', '');
      var mosaic = root.querySelector('[data-collection-grid]');
      if (!mosaic) return;
      var ssrCols = Number(mosaic.getAttribute('data-ssr-cols') || '0');
      var items = Array.prototype.slice.call(
        mosaic.querySelectorAll('[data-collection-col] > [data-ratio]'),
      );
      if (!items.length) return;

      function pack(n) {
        var columns = [];
        var heights = [];
        for (var c = 0; c < n; c++) {
          var col = document.createElement('div');
          col.setAttribute('data-collection-col', '');
          col.style.cssText =
            'display:flex;flex-direction:column;gap:' + GAP + 'px;min-width:0';
          columns.push(col);
          heights.push(0);
        }
        for (var i = 0; i < items.length; i++) {
          var shortest = 0;
          for (var k = 1; k < n; k++) if (heights[k] < heights[shortest]) shortest = k;
          columns[shortest].appendChild(items[i]);
          heights[shortest] += parseFloat(items[i].getAttribute('data-ratio')) || 1;
        }
        mosaic.style.gridTemplateColumns = 'repeat(' + n + ', minmax(0, 1fr))';
        mosaic.replaceChildren.apply(mosaic, columns);
      }

      var current = 0;
      function layout() {
        var n = columnCount();
        if (n === current) return;
        if (n === ssrCols && current === 0) {
          current = n;
          mosaic.style.gridTemplateColumns = 'repeat(' + n + ', minmax(0, 1fr))';
          return;
        }
        current = n;
        pack(n);
      }

      layout();
      window.matchMedia('(min-width: 64rem)').addEventListener('change', layout);
    }

    var staticRoots = document.querySelectorAll(
      '[data-collection-mosaic]:not([data-sortable]):not([data-ready])',
    );
    for (var s = 0; s < staticRoots.length; s++) reflowStatic(staticRoots[s]);

    var roots = document.querySelectorAll(
      '[data-collection-mosaic][data-sortable]:not([data-ready])',
    );
    for (var r = 0; r < roots.length; r++) initCollectionMosaic(roots[r]);

    function initCollectionMosaic(root) {
          if (root.getAttribute('data-ready') != null) return;
          root.setAttribute('data-ready', '');

          var mosaic = root.querySelector('[data-collection-grid]');
          if (!mosaic) return;

          var queries = [window.matchMedia('(min-width: 64rem)')];
          var current = 0;
          var heights = [];
          var pendingToken = null;
          var built = false;

          function isEffectivelyHidden() {
            return Boolean(root.hidden || root.closest('[hidden]'));
          }

          var allScript = root.querySelector('[data-collection-all]');
          var allItems = [];
          try {
            allItems = allScript ? JSON.parse(allScript.textContent || '[]') : [];
          } catch (e) {
            allItems = [];
          }

          var cardTemplateEl = root.querySelector('[data-collection-card-template]');
          var cardPrototype =
            cardTemplateEl && cardTemplateEl.content
              ? cardTemplateEl.content.firstElementChild
              : null;

          function buildCard(item) {
            var ratio = (item.height / item.width).toFixed(4);
            var wrap = document.createElement('div');
            wrap.setAttribute('data-ratio', ratio);
            wrap.className = 'min-w-0';
            if (!cardPrototype) return wrap;

            var card = cardPrototype.cloneNode(true);
            var link = card.matches('[data-card-link]')
              ? card
              : card.querySelector('[data-card-link]');
            var img = card.querySelector('[data-card-img]');
            var count = card.querySelector('[data-card-count]');
            var title = card.querySelector('[data-card-title]');
            var meta = card.querySelector('[data-card-meta]');

            if (link) {
              link.setAttribute('href', item.href);
              link.style.aspectRatio = item.width + ' / ' + item.height;
            }
            if (img) {
              img.setAttribute('src', item.thumb);
              img.setAttribute('alt', item.alt || item.title);
              img.setAttribute('width', String(item.width));
              img.setAttribute('height', String(item.height));
              img.setAttribute('loading', 'lazy');
              img.removeAttribute('fetchpriority');
            }
            if (count) count.textContent = item.badge;
            if (title) title.textContent = item.title;
            if (meta) {
              if (item.meta) {
                meta.textContent = item.meta;
                meta.hidden = false;
              } else {
                meta.textContent = '';
                meta.hidden = true;
              }
            }
            wrap.appendChild(card);
            return wrap;
          }

          function mulberry32(seed) {
            var a = seed >>> 0;
            return function () {
              a = (a + 0x6d2b79f5) >>> 0;
              var t = a;
              t = Math.imul(t ^ (t >>> 15), t | 1);
              t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
              return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
            };
          }

          function shuffleSeed(refresh) {
            try {
              if (!refresh) {
                var existing = sessionStorage.getItem('mosaic-shuffle-seed');
                if (existing) return Number(existing) >>> 0;
              }
              var seed = (Date.now() ^ Math.floor(Math.random() * 0x100000000)) >>> 0;
              sessionStorage.setItem('mosaic-shuffle-seed', String(seed));
              return seed;
            } catch (e) {
              return Date.now() >>> 0;
            }
          }

          function orderItems(list, token, reshuffle) {
            var copy = list.slice();
            var desc = token === 'alpha:desc' || token === 'date' || token === 'date:desc';
            var sign = desc ? -1 : 1;
            if (token === 'alpha' || token === 'alpha:asc' || token === 'alpha:desc') {
              copy.sort(function (a, b) {
                return (
                  String(a.title || '').localeCompare(String(b.title || ''), 'da') * sign
                );
              });
            } else if (token === 'date' || token === 'date:asc' || token === 'date:desc') {
              copy.sort(function (a, b) {
                return (
                  String(a.publishedAt || '').localeCompare(String(b.publishedAt || '')) *
                  sign
                );
              });
            } else {
              var rand = mulberry32(shuffleSeed(Boolean(reshuffle)));
              for (var i = copy.length - 1; i > 0; i--) {
                var j = Math.floor(rand() * (i + 1));
                var tmp = copy[i];
                copy[i] = copy[j];
                copy[j] = tmp;
              }
            }
            return copy;
          }

          function pageDefaultSort() {
            return root.getAttribute('data-default-sort') || 'shuffle';
          }

          function persistSortEnabled() {
            return root.getAttribute('data-persist-sort') !== 'false';
          }

          function isValidSortToken(token) {
            return (
              token === 'shuffle' ||
              token === 'alpha' ||
              token === 'date' ||
              token === 'alpha:asc' ||
              token === 'alpha:desc' ||
              token === 'date:asc' ||
              token === 'date:desc'
            );
          }

          function readSortToken() {
            if (!persistSortEnabled()) return pageDefaultSort();
            try {
              var token = sessionStorage.getItem('mosaic-sort');
              if (isValidSortToken(token)) return token;
            } catch (e) {}
            return pageDefaultSort();
          }

          function pack(items, n) {
            var columns = [];
            heights = [];
            for (var c = 0; c < n; c++) {
              var col = document.createElement('div');
              col.setAttribute('data-collection-col', '');
              col.style.cssText =
                'display:flex;flex-direction:column;gap:' + GAP + 'px;min-width:0';
              columns.push(col);
              heights.push(0);
            }
            for (var i = 0; i < items.length; i++) {
              var shortest = 0;
              for (var k = 1; k < n; k++) if (heights[k] < heights[shortest]) shortest = k;
              var card = buildCard(items[i]);
              columns[shortest].appendChild(card);
              heights[shortest] += parseFloat(card.getAttribute('data-ratio')) || 1;
            }
            mosaic.style.gridTemplateColumns = 'repeat(' + n + ', minmax(0, 1fr))';
            mosaic.replaceChildren.apply(mosaic, columns);
          }

          function renderSorted(token, reshuffle) {
            if (
              token !== 'shuffle' &&
              token !== 'alpha' &&
              token !== 'date' &&
              token !== 'alpha:asc' &&
              token !== 'alpha:desc' &&
              token !== 'date:asc' &&
              token !== 'date:desc'
            ) {
              token = 'shuffle';
            }
            pendingToken = token;
            if (isEffectivelyHidden()) return;
            built = true;
            var ordered = orderItems(allItems, token, reshuffle);
            current = columnCount();
            pack(ordered, current);
          }

          function ensureVisible() {
            if (isEffectivelyHidden()) return;
            if (!built) {
              renderSorted(pendingToken || readSortToken(), false);
            } else if (pendingToken) {
              renderSorted(pendingToken, false);
            }
          }

          root._renderSorted = renderSorted;
          root._ensureVisible = ensureVisible;

          if (!isEffectivelyHidden()) {
            renderSorted(readSortToken(), false);
          } else {
            pendingToken = readSortToken();
          }

          queries.forEach(function (q) {
            q.addEventListener('change', function () {
              if (isEffectivelyHidden() || !built) return;
              var n = columnCount();
              if (n === current) return;
              renderSorted(pendingToken || readSortToken(), false);
            });
          });
        }

    function initCollectionMosaicRoot(root) {
      if (!root) return;
      if (root.hasAttribute('data-sortable')) initCollectionMosaic(root);
      else reflowStatic(root);
    }

    (window.__mk = window.__mk || {}).initCollectionMosaic = initCollectionMosaicRoot;
  })();
</script>
