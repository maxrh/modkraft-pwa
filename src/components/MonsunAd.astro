---
import { ArrowRight } from 'lucide-react';
import { MONSUN } from '@/lib/site';

interface Props {
  class?: string;
  videoSrc?: string;
  phrases?: readonly string[];
  href?: string;
}

const DEFAULT_VIDEO =
  'https://res.cloudinary.com/maxrh/video/upload/v1757605109/monsun.dk/Videos/experimentsinmotiongraphics_24_uuzoki.mp4';

const DEFAULT_PHRASES = [
  'MONSUN',
  'Website',
  'Design',
  'Visuel Identitet',
  'Magasin',
  'Plakat',
  'Avis',
  'Folder',
  'Foto',
  'Brætspil',
  'WebApp',
  'Bog',
  'Logo',
  'Free Palestine',
  'Grafik',
] as const;

const {
  class: className,
  videoSrc = DEFAULT_VIDEO,
  phrases = DEFAULT_PHRASES,
  href = MONSUN.url,
} = Astro.props;
---

<a
  href={href}
  class:list={['monsun-ad', className]}
  data-monsun-ad
  aria-label="Besøg monsun.dk"
  rel="noopener noreferrer"
  target="_blank"
>
  <video
    class="monsun-ad__video"
    data-src={videoSrc}
    muted
    loop
    playsinline
    width="640"
    height="360"
  ></video>
  <div class="monsun-ad__inner" aria-hidden="true">
    <ul class="monsun-ad__slideshow">
      {
        phrases.map((phrase, i) => (
          <li class:list={[i === 0 && 'active']}>
            <span>{phrase}</span>
          </li>
        ))
      }
    </ul>
  </div>
  <span class="monsun-ad__cta" aria-hidden="true">
    Besøg monsun.dk
    <ArrowRight className="size-4 shrink-0" aria-hidden="true" />
  </span>
</a>

<style>
  .monsun-ad {
    isolation: isolate;
    container-type: inline-size;
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    width: 100%;
    overflow: hidden;
    background: #111;
    text-decoration: none;
    color: inherit;
  }

  .monsun-ad:focus-visible {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  .monsun-ad__video {
    position: absolute;
    inset: 0;
    z-index: -1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .monsun-ad__inner {
    position: relative;
    display: flex;
    height: 100%;
    width: 100%;
    align-items: center;
    justify-content: center;
    padding: 0;
  }

  .monsun-ad__slideshow {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
  }

  .monsun-ad__slideshow li {
    display: none;
  }

  .monsun-ad__slideshow li.active {
    display: list-item;
  }

  .monsun-ad__slideshow span {
    display: block;
    font-family: var(--font-display);
    color: #f1f1f1;
    /* Same logic as monsun.dk `28vw`, scoped to the ad width. */
    font-size: 28cqi;
    font-weight: 900;
    line-height: 0.75;
    letter-spacing: -0.01em;
    mix-blend-mode: difference;
    pointer-events: none;
  }

  .monsun-ad__cta {
    position: absolute;
    top: 1rem;
    left: 1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin: 0;
    color: #f1f1f1;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.25;
    letter-spacing: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 200ms ease;
  }

  .monsun-ad:hover .monsun-ad__cta,
  .monsun-ad:focus-visible .monsun-ad__cta {
    opacity: 1;
  }
</style>

<script is:inline data-astro-rerun>
  (function () {
    var roots = document.querySelectorAll('[data-monsun-ad]:not([data-ready])');
    for (var i = 0; i < roots.length; i++) initMonsunAd(roots[i]);

    function initMonsunAd(root) {
      if (!root || root.hasAttribute('data-ready')) return;
      root.setAttribute('data-ready', '');

      var video = root.querySelector('.monsun-ad__video');
      var items = root.querySelectorAll('.monsun-ad__slideshow li');
      var reduceMotion =
        typeof window.matchMedia === 'function' &&
        window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (items.length > 0) {
        var index = 0;
        var hovering = false;
        var timer = null;

        function setActive(next) {
          items[index].classList.remove('active');
          index = next;
          items[index].classList.add('active');
        }

        function showMonsun() {
          setActive(0);
        }

        function startTimer() {
          if (reduceMotion || items.length < 2 || timer !== null) return;
          timer = window.setInterval(function () {
            if (!root.isConnected) {
              window.clearInterval(timer);
              timer = null;
              return;
            }
            if (hovering) return;
            setActive((index + 1) % items.length);
          }, 2000);
        }

        setActive(0);
        startTimer();

        root.addEventListener('pointerenter', function () {
          hovering = true;
          showMonsun();
        });
        root.addEventListener('pointerleave', function () {
          hovering = false;
        });
      }

      if (reduceMotion || !video) return;

      var src = video.getAttribute('data-src');
      if (!src) return;

      function attach() {
        if (video.getAttribute('src') === src) {
          var playPromise = video.play();
          if (playPromise && typeof playPromise.catch === 'function') {
            playPromise.catch(function () {});
          }
          return;
        }
        video.setAttribute('src', src);
        video.load();
        var p = video.play();
        if (p && typeof p.catch === 'function') {
          p.catch(function () {});
        }
      }

      function detach() {
        if (!video.getAttribute('src')) return;
        video.pause();
        video.removeAttribute('src');
        video.load();
      }

      if (typeof IntersectionObserver !== 'function') {
        attach();
        return;
      }

      var observer = new IntersectionObserver(
        function (entries) {
          for (var e = 0; e < entries.length; e++) {
            if (entries[e].isIntersecting) attach();
            else detach();
          }
        },
        { rootMargin: '400px 0px' },
      );
      observer.observe(root);
    }
  })();
</script>
