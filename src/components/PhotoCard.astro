---
import type { Photo } from '@/lib/photos';

interface Props {
  photo: Photo;
  highPriority?: boolean;
}

const { photo, highPriority = false } = Astro.props;
const altText = photo.caption || `${photo.collectionTitle} (${photo.sortOrder}/${photo.imageCount})`;
---

<a
  data-card-link
  href={photo.href}
  class="group relative block w-full overflow-hidden rounded-sm bg-muted no-underline focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
  style={`aspect-ratio: ${photo.width} / ${photo.height};`}
>
  <img
    data-card-img
    src={photo.thumb}
    alt={altText}
    width={photo.width}
    height={photo.height}
    loading={highPriority ? 'eager' : 'lazy'}
    fetchpriority={highPriority ? 'high' : undefined}
    decoding="async"
    sizes="(max-width: 40rem) 100vw, (max-width: 64rem) 50vw, 33vw"
    class="photo-img absolute inset-0 block h-full w-full object-cover text-transparent transition-transform duration-300 group-hover:scale-[1.015]"
  />

  <div
    class="pointer-events-none absolute inset-0 flex flex-col justify-between bg-gradient-to-t from-black/80 via-black/20 to-black/30 p-5 text-white opacity-0 transition-opacity duration-200 group-hover:opacity-100 group-focus-visible:opacity-100"
  >
    <div class="flex items-start justify-end text-[11px] font-medium tracking-wide">
      <span
        data-card-count
        class="shrink-0 rounded bg-black/70 px-1.5 py-0.5 tabular-nums"
      >
        {photo.sortOrder}/{photo.imageCount}
      </span>
    </div>

    <div class="space-y-1">
      <p
        data-card-title
        class="font-display line-clamp-2 text-xl/5 font-semibold text-white drop-shadow-xs"
      >
        {photo.collectionTitle}
      </p>
      <p
        data-card-credit-row
        class="pt-0.5 text-xs font-medium  text-white/90"
        hidden={!photo.credit}
      >
        <span data-card-credit>{photo.credit}</span>
      </p>
    </div>
  </div>
</a>
