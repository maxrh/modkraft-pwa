---
import { getCollection } from 'astro:content';
import { ArrowLeft, ArrowRight, Calendar, Camera, Maximize2, Minimize2, Scaling } from 'lucide-react';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/layout/Container.astro';
import TagPills from '@/components/layout/TagPills.astro';
import PhotoMosaic from '@/components/PhotoMosaic.astro';
import { buttonVariants } from '@/components/ui/button';
import { readCameraModel } from '@/lib/exif';
import {
  collectionKind,
  collectionKindLabel,
  flattenCollectionPhotos,
  formatDate,
  photoPageSeo,
  sortCollectionsNewest,
  type Photo,
} from '@/lib/photos';
import { cn } from '@/lib/utils';

export async function getStaticPaths() {
  const collections = (await getCollection('photoCollections')).sort(sortCollectionsNewest);

  const paths: Array<{
    params: { collectionId: string; imageId: string };
    props: {
      photo: Photo;
      siblings: Photo[];
      prevPhoto: Photo | null;
      nextPhoto: Photo | null;
    };
  }> = [];

  for (const collection of collections) {
    const photos = flattenCollectionPhotos(collection);
    for (let i = 0; i < photos.length; i++) {
      const photo = photos[i];
      paths.push({
        params: {
          collectionId: photo.collectionId,
          imageId: photo.imageId,
        },
        props: {
          photo,
          siblings: photos.filter((p) => p.imageId !== photo.imageId),
          prevPhoto: i > 0 ? photos[i - 1] : null,
          nextPhoto: i < photos.length - 1 ? photos[i + 1] : null,
        },
      });
    }
  }

  return paths;
}

interface Props {
  photo: Photo;
  siblings: Photo[];
  prevPhoto: Photo | null;
  nextPhoto: Photo | null;
}

const { photo, siblings, prevPhoto, nextPhoto } = Astro.props;
const kind = collectionKind(photo.sourceType);
const kindLabel = collectionKindLabel(photo.sourceType);
const cameraModel = await readCameraModel(photo.collectionId, photo.filename);
const seo = photoPageSeo(photo);
const configuredSite = import.meta.env.PUBLIC_SITE || Astro.site?.origin;
const siteOrigin = String(configuredSite || Astro.url.origin).replace(/\/$/, '');
const pageUrl = new URL(photo.href, siteOrigin).href;
const imageUrlAbs = new URL(photo.display, siteOrigin).href;
const seriesUrl = new URL(`/fotoserie/${photo.collectionId}`, siteOrigin).href;
const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'ImageObject',
  contentUrl: imageUrlAbs,
  url: pageUrl,
  name: seo.title,
  description: seo.description,
  width: photo.width,
  height: photo.height,
  datePublished: photo.publishedAt,
  isPartOf: {
    '@type': 'CollectionPage',
    name: photo.collectionTitle,
    url: seriesUrl,
  },
};
if (photo.caption) jsonLd.caption = photo.caption;
if (photo.credit) jsonLd.creator = { '@type': 'Person', name: photo.credit };

const metaRows: Array<{ icon: 'calendar' | 'scaling' | 'camera'; value: string }> = [];
if (photo.publishedAt) {
  metaRows.push({ icon: 'calendar', value: `Publiceret ${formatDate(photo.publishedAt)}` });
}
if (photo.width && photo.height) {
  metaRows.push({ icon: 'scaling', value: `${photo.width} × ${photo.height}` });
}
if (cameraModel) {
  metaRows.push({ icon: 'camera', value: cameraModel });
}
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  canonical={pageUrl}
  image={imageUrlAbs}
  imageAlt={seo.alt}
  jsonLd={jsonLd}
>
  {prevPhoto && <link rel="preload" as="image" href={prevPhoto.display} />}
  {nextPhoto && <link rel="preload" as="image" href={nextPhoto.display} />}
  <noscript>
    <style is:inline>
      [data-photo-slide] img {
        opacity: 1 !important;
      }
    </style>
  </noscript>

  <article>
  <section
    class="flex h-[calc(100dvh-var(--site-header-h))] flex-col"
    data-photo-slide
  >
    <Container size="stage" class="flex w-full min-h-0 flex-1 flex-col pt-8">
      <nav aria-label="Foto" class="mb-4 flex shrink-0 flex-wrap items-center justify-between gap-4">
        <div class="flex flex-wrap items-center gap-1 text-base">
          {kindLabel}:
          <a
            href={`/fotoserie/${photo.collectionId}`}
            class="inline-flex items-center gap-1 font-semibold text-foreground leading-tight no-underline hover:underline"
          >
            {photo.collectionTitle}
            <ArrowRight className="size-3.5 shrink-0" aria-hidden="true" />
          </a>
        </div>

        <div class="flex items-center gap-1">
          <span
            class={cn(
              buttonVariants({ variant: 'ghost', size: 'sm' }),
              'pointer-events-none text-muted-foreground tabular-nums hover:bg-muted',
            )}
          >
            {photo.sortOrder} / {photo.imageCount}
          </span>
          {
            prevPhoto ? (
              <a
                href={prevPhoto.href}
                class={cn(
                  buttonVariants({ variant: 'ghost', size: 'icon' }),
                  'bg-accent no-underline shadow-none hover:bg-muted',
                )}
                title={`Forrige foto i ${kind === 'fotoblog' ? 'fotobloggen' : 'fotoserien'}`}
              >
                <ArrowLeft aria-hidden="true" />
              </a>
            ) : (
              <span
                class={cn(
                  buttonVariants({ variant: 'ghost', size: 'icon' }),
                  'pointer-events-none bg-accent opacity-40 shadow-none',
                )}
                aria-disabled="true"
              >
                <ArrowLeft aria-hidden="true" />
              </span>
            )
          }
          {
            nextPhoto ? (
              <a
                href={nextPhoto.href}
                class={cn(
                  buttonVariants({ variant: 'ghost', size: 'icon' }),
                  'bg-accent no-underline shadow-none hover:bg-muted',
                )}
                title={`Næste foto i ${kind === 'fotoblog' ? 'fotobloggen' : 'fotoserien'}`}
              >
                <ArrowRight aria-hidden="true" />
              </a>
            ) : (
              <span
                class={cn(
                  buttonVariants({ variant: 'ghost', size: 'icon' }),
                  'pointer-events-none bg-accent opacity-40 shadow-none',
                )}
                aria-disabled="true"
              >
                <ArrowRight aria-hidden="true" />
              </span>
            )
          }
        </div>
      </nav>

      <figure class="flex w-full min-h-0 flex-1 items-center justify-center overflow-hidden">
        <div class="flex h-full min-h-0 w-full max-w-full flex-col items-center justify-center">
          <div
            data-photo-open
            class:list={[
              'group relative min-h-0 max-w-full cursor-zoom-in',
              photo.caption ? 'max-h-[calc(100%-2.25rem)]' : 'max-h-full',
            ]}
          >
            <img
              src={photo.display}
              alt={seo.alt}
              width={photo.width}
              height={photo.height}
              class="block min-h-0 w-auto max-h-full max-w-full object-contain opacity-0 transition-opacity duration-300 data-[loaded]:opacity-100"
              onload="this.dataset.loaded=''; if (window.__syncPhotoCaption) window.__syncPhotoCaption(this)"
            />
            <Maximize2
              aria-hidden="true"
              className="pointer-events-none absolute top-5 right-5 size-6 text-white opacity-0 drop-shadow transition-opacity duration-200 group-hover:opacity-100 sm:top-6 sm:right-6"
            />
          </div>
          {
            photo.caption && (
              <figcaption class="mt-2 max-w-full text-left text-sm leading-snug text-foreground">
                <h1 data-photo-caption class="font-normal leading-snug">
                  {photo.caption}
                </h1>
              </figcaption>
            )
          }
        </div>
      </figure>

      <div class="h-12 shrink-0 bg-white" aria-hidden="true"></div>
    </Container>
  </section>

  <dialog
    data-photo-lightbox
    aria-label="Luk fuld størrelse"
    class="m-0 h-dvh max-h-none w-screen max-w-none cursor-zoom-out overflow-auto border-0 bg-transparent p-0 open:grid open:place-items-center backdrop:bg-black/80"
  >
    <Minimize2
      aria-hidden="true"
      className="pointer-events-none fixed top-5 right-5 z-10 size-6 text-white drop-shadow sm:top-6 sm:right-6"
    />
    <img
      data-photo-lightbox-img
      data-full-src={photo.src}
      alt={seo.alt}
      width={photo.width}
      height={photo.height}
      class="h-auto w-auto max-w-[100vw] cursor-zoom-out"
    />
  </dialog>

  <Container size="stage" class:list={['pt-8', siblings.length > 0 ? 'pb-0' : 'pb-16']}>
    {
      photo.credit && (
        <p class="text-base font-medium text-foreground">
          {photo.credit}
        </p>
      )
    }

    {
      metaRows.length > 0 && (
        <dl class:list={['space-y-1.5', photo.credit ? 'mt-3' : undefined]}>
          {metaRows.map((row) => (
            <div class="flex items-start gap-2.5">
              <dt class="mt-0.5 shrink-0 text-muted-foreground">
                {row.icon === 'calendar' ? (
                  <Calendar className="size-4" aria-hidden="true" />
                ) : row.icon === 'scaling' ? (
                  <Scaling className="size-4" aria-hidden="true" />
                ) : (
                  <Camera className="size-4" aria-hidden="true" />
                )}
                <span class="sr-only">
                  {row.icon === 'calendar'
                    ? 'Publiceret'
                    : row.icon === 'scaling'
                      ? 'Dimensioner'
                      : 'Kamera'}
                </span>
              </dt>
              <dd class="text-sm text-foreground font-light">{row.value}</dd>
            </div>
          ))}
        </dl>
      )
    }

    {photo.tags.length > 0 && <TagPills tags={photo.tags} class="mt-6" />}
  </Container>
  </article>

  {
    siblings.length > 0 && (
      <Container size="stage" class="py-20">
        <section>
          <h2 class="mb-5 font-display text-xl font-semibold sm:text-2xl">
            Fra samme {kind}
          </h2>
          <PhotoMosaic photos={siblings} />
        </section>
      </Container>
    )
  }
  <script is:inline>
    (function () {
      function revealPhotoSlides() {
        var imgs = document.querySelectorAll('[data-photo-slide] [data-photo-open] img');
        for (var i = 0; i < imgs.length; i++) {
          if (imgs[i].complete && imgs[i].naturalWidth) imgs[i].dataset.loaded = '';
          if (window.__syncPhotoCaption) window.__syncPhotoCaption(imgs[i]);
        }
      }

      function wirePhotoLightbox() {
        var dialog = document.querySelector('[data-photo-lightbox]');
        if (!dialog) return;

        var openEl = document.querySelector('[data-photo-open]');
        var lightboxImg = dialog.querySelector('[data-photo-lightbox-img]');
        if (!openEl || !lightboxImg) return;

        function openLightbox() {
          var fullSrc = lightboxImg.getAttribute('data-full-src');
          if (fullSrc && lightboxImg.getAttribute('src') !== fullSrc) {
            lightboxImg.setAttribute('src', fullSrc);
          }
          if (typeof dialog.showModal === 'function' && !dialog.open) dialog.showModal();
        }

        function closeLightbox() {
          if (dialog.open) dialog.close();
        }

        // onclick so ClientRouter rebinds cleanly without stacking listeners
        openEl.onclick = openLightbox;
        dialog.onclick = closeLightbox;
      }

      function onPhotoPageLoad() {
        revealPhotoSlides();
        wirePhotoLightbox();
      }

      onPhotoPageLoad();
      if (!window.__photoSlideReveal) {
        window.__photoSlideReveal = true;
        document.addEventListener('astro:page-load', onPhotoPageLoad);
      }
    })();
  </script>
</BaseLayout>
