---
import { getCollection } from 'astro:content';
import { ArrowLeft, ArrowRight, Calendar, Camera, Scaling } from 'lucide-react';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/layout/Container.astro';
import TagPills from '@/components/layout/TagPills.astro';
import PhotoMosaic from '@/components/PhotoMosaic.astro';
import { buttonVariants } from '@/components/ui/button';
import { readCameraModel } from '@/lib/exif';
import {
  collectionKind,
  collectionKindLabel,
  flattenCollectionPhotos,
  formatDate,
  sortCollectionsNewest,
  type Photo,
} from '@/lib/photos';
import { cn } from '@/lib/utils';

export async function getStaticPaths() {
  const collections = (await getCollection('photoCollections')).sort(sortCollectionsNewest);

  const paths: Array<{
    params: { collectionId: string; imageId: string };
    props: {
      photo: Photo;
      siblings: Photo[];
      prevPhoto: Photo | null;
      nextPhoto: Photo | null;
    };
  }> = [];

  for (const collection of collections) {
    const photos = flattenCollectionPhotos(collection);
    for (let i = 0; i < photos.length; i++) {
      const photo = photos[i];
      paths.push({
        params: {
          collectionId: photo.collectionId,
          imageId: photo.imageId,
        },
        props: {
          photo,
          siblings: photos.filter((p) => p.imageId !== photo.imageId),
          prevPhoto: i > 0 ? photos[i - 1] : null,
          nextPhoto: i < photos.length - 1 ? photos[i + 1] : null,
        },
      });
    }
  }

  return paths;
}

interface Props {
  photo: Photo;
  siblings: Photo[];
  prevPhoto: Photo | null;
  nextPhoto: Photo | null;
}

const { photo, siblings, prevPhoto, nextPhoto } = Astro.props;
const kind = collectionKind(photo.sourceType);
const kindLabel = collectionKindLabel(photo.sourceType);
const cameraModel = await readCameraModel(photo.collectionId, photo.filename);
const pageTitle = photo.caption
  ? `${photo.caption.slice(0, 60)} — ${photo.collectionTitle}`
  : `${photo.collectionTitle} (${photo.sortOrder}/${photo.imageCount})`;

const metaRows: Array<{ icon: 'calendar' | 'scaling' | 'camera'; value: string }> = [];
if (photo.publishedAt) {
  metaRows.push({ icon: 'calendar', value: `Publiceret ${formatDate(photo.publishedAt)}` });
}
if (photo.width && photo.height) {
  metaRows.push({ icon: 'scaling', value: `${photo.width} × ${photo.height}` });
}
if (cameraModel) {
  metaRows.push({ icon: 'camera', value: cameraModel });
}
---

<BaseLayout
  title={pageTitle}
  description={photo.caption || `Foto fra ${photo.collectionTitle}`}
>
  {prevPhoto && <link rel="preload" as="image" href={prevPhoto.src} />}
  {nextPhoto && <link rel="preload" as="image" href={nextPhoto.src} />}
  <noscript>
    <style is:inline>
      [data-photo-slide] img {
        opacity: 1 !important;
      }
    </style>
  </noscript>

  <section
    class="flex h-[calc(100dvh-var(--site-header-h))] flex-col"
    data-photo-slide
  >
    <Container class="flex w-full min-h-0 flex-1 flex-col pt-8">
      <header class="mb-6 flex shrink-0 flex-wrap items-center justify-between gap-4">
        <div class="flex flex-wrap items-center gap-1 text-base">
          {kindLabel}:
          <a
            href={`/fotoserie/${photo.collectionId}`}
            class="inline-flex items-center gap-1 font-semibold text-foreground no-underline hover:underline"
          >
            {photo.collectionTitle}
            <ArrowRight className="size-3.5 shrink-0" aria-hidden="true" />
          </a>
          {
            photo.series && (
              <>
                <span class="text-muted-foreground">·</span>
                <a
                  href={`/fotoblog/${photo.series}`}
                  class="rounded bg-secondary px-2 py-0.5 text-xs font-medium text-secondary-foreground no-underline hover:bg-accent"
                >
                  Fotoblog
                </a>
              </>
            )
          }
        </div>

        <div class="flex items-center gap-1">
          <span
            class={cn(
              buttonVariants({ variant: 'ghost', size: 'sm' }),
              'pointer-events-none text-muted-foreground tabular-nums hover:bg-muted',
            )}
          >
            {photo.sortOrder} / {photo.imageCount}
          </span>
          {
            prevPhoto ? (
              <a
                href={prevPhoto.href}
                class={cn(
                  buttonVariants({ variant: 'ghost', size: 'icon' }),
                  'bg-accent no-underline shadow-none hover:bg-muted',
                )}
                title={`Forrige foto i ${kind === 'fotoblog' ? 'fotobloggen' : 'fotoserien'}`}
              >
                <ArrowLeft aria-hidden="true" />
              </a>
            ) : (
              <span
                class={cn(
                  buttonVariants({ variant: 'ghost', size: 'icon' }),
                  'pointer-events-none bg-accent opacity-40 shadow-none',
                )}
                aria-disabled="true"
              >
                <ArrowLeft aria-hidden="true" />
              </span>
            )
          }
          {
            nextPhoto ? (
              <a
                href={nextPhoto.href}
                class={cn(
                  buttonVariants({ variant: 'ghost', size: 'icon' }),
                  'bg-accent no-underline shadow-none hover:bg-muted',
                )}
                title={`Næste foto i ${kind === 'fotoblog' ? 'fotobloggen' : 'fotoserien'}`}
              >
                <ArrowRight aria-hidden="true" />
              </a>
            ) : (
              <span
                class={cn(
                  buttonVariants({ variant: 'ghost', size: 'icon' }),
                  'pointer-events-none bg-accent opacity-40 shadow-none',
                )}
                aria-disabled="true"
              >
                <ArrowRight aria-hidden="true" />
              </span>
            )
          }
        </div>
      </header>

      <figure class="relative flex w-full min-h-0 flex-1 items-center justify-center">
        <img
          src={photo.src}
          alt={photo.caption || photo.collectionTitle}
          width={photo.width}
          height={photo.height}
          class="max-h-full min-h-0 max-w-full object-contain opacity-0 transition-opacity duration-300 data-[loaded]:opacity-100"
          onload="this.dataset.loaded = ''"
        />
      </figure>

      <div class="h-12 shrink-0 bg-white" aria-hidden="true"></div>
    </Container>
  </section>

  <Container class="pt-8 pb-16">
    <article>
      <section>
        {
          photo.caption && (
            <h1 class="font-display text-2xl font-bold tracking-normal sm:text-2xl">
              {photo.caption}
            </h1>
          )
        }

        {
          photo.credit && (
            <p
              class:list={[
                'text-base font-medium text-foreground sm:text-base',
                photo.caption ? 'mt-1' : undefined,
              ]}
            >
              {photo.credit}
            </p>
          )
        }

        {
          metaRows.length > 0 && (
            <dl
              class:list={[
                'space-y-1.5',
                photo.caption || photo.credit ? 'mt-3' : undefined,
              ]}
            >
              {metaRows.map((row) => (
                <div class="flex items-start gap-2.5">
                  <dt class="mt-0.5 shrink-0 text-muted-foreground">
                    {row.icon === 'calendar' ? (
                      <Calendar className="size-4" aria-hidden="true" />
                    ) : row.icon === 'scaling' ? (
                      <Scaling className="size-4" aria-hidden="true" />
                    ) : (
                      <Camera className="size-4" aria-hidden="true" />
                    )}
                    <span class="sr-only">
                      {row.icon === 'calendar'
                        ? 'Publiceret'
                        : row.icon === 'scaling'
                          ? 'Dimensioner'
                          : 'Kamera'}
                    </span>
                  </dt>
                  <dd class="text-sm text-foreground font-light">{row.value}</dd>
                </div>
              ))}
            </dl>
          )
        }

        {photo.tags.length > 0 && <TagPills tags={photo.tags} class="mt-6" />}

        
      </section>

      <!-- Rest of images in this collection -->
      {
        siblings.length > 0 && (
          <section class="mt-14">
            <h2 class="mb-5 font-display text-xl font-semibold sm:text-2xl">
              Fotos fra samme {kind}
            </h2>
            <PhotoMosaic photos={siblings} />
          </section>
        )
      }
    </article>
  </Container>
  <script is:inline>
    (function () {
      function revealPhotoSlides() {
        var imgs = document.querySelectorAll('[data-photo-slide] img');
        for (var i = 0; i < imgs.length; i++) {
          if (imgs[i].complete && imgs[i].naturalWidth) imgs[i].dataset.loaded = '';
        }
      }
      revealPhotoSlides();
      if (!window.__photoSlideReveal) {
        window.__photoSlideReveal = true;
        document.addEventListener('astro:page-load', revealPhotoSlides);
      }
    })();
  </script>
</BaseLayout>
