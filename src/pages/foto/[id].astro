---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { renderMarkdown } from '@/lib/markdown';
import { byline, formatDate, imageUrl } from '@/lib/photos';

export async function getStaticPaths() {
  const collections = await getCollection('photoCollections');
  return collections.map((collection) => ({
    params: { id: collection.id },
  }));
}

const { id } = Astro.params;
const collection = await getEntry('photoCollections', id!);
if (!collection) {
  throw new Error(`Unknown photo collection: ${id}`);
}

const data = collection.data;
const manchetHtml = renderMarkdown(data.manchet);
const introHtml = renderMarkdown(data.introMarkdown);
const images = [...data.images].sort((a, b) => a.sortOrder - b.sortOrder);
---

<BaseLayout
  title={data.title}
  description={data.manchet?.slice(0, 160) || `Fotoserie: ${data.title}`}
>
  <article class="mx-auto max-w-4xl px-4 pt-10 pb-16 sm:px-6">
    <p class="mb-4">
      <a href="/foto" class="text-sm text-muted-foreground no-underline hover:text-foreground">← Alle fotos</a>
      {
        data.series && (
          <>
            <span class="mx-2 text-muted-foreground">·</span>
            <a
              href={`/foto/serie/${data.series}`}
              class="text-sm text-muted-foreground no-underline hover:text-foreground"
            >
              Serie
            </a>
          </>
        )
      }
    </p>

    {
      data.prefix && (
        <p class="mb-2 text-sm font-medium tracking-wide text-muted-foreground uppercase">{data.prefix}</p>
      )
    }

    <h1 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">{data.title}</h1>

    <p class="mt-3 text-muted-foreground">
      {formatDate(data.publishedAt)}
      {data.authors.length ? ` · ${byline(data.authors)}` : ''}
      {` · ${images.length} fotos`}
    </p>

    {
      data.tags.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-2">
          {data.tags.map((tag) => (
            <li>
              <a
                href={`/foto/tag/${encodeURIComponent(tag)}`}
                class="rounded-md border border-border px-2.5 py-1 text-xs text-muted-foreground no-underline hover:text-foreground"
              >
                {tag}
              </a>
            </li>
          ))}
        </ul>
      )
    }

    {manchetHtml && <div class="prose prose-neutral mt-8 max-w-none" set:html={manchetHtml} />}

    {introHtml && <div class="prose prose-neutral mt-6 max-w-none" set:html={introHtml} />}

    <div class="mt-12 space-y-12">
      {
        images.map((image) => (
          <figure class="space-y-3">
            <img
              src={imageUrl(data.id, image.filename)}
              alt={image.caption || data.title}
              width={image.width ?? undefined}
              height={image.height ?? undefined}
              loading="lazy"
              decoding="async"
              class="w-full rounded-lg bg-muted"
            />
            {(image.caption || image.credit) && (
              <figcaption class="text-sm text-muted-foreground">
                {image.caption && <p class="m-0">{image.caption}</p>}
                {image.credit && (
                  <p class:list={['m-0 text-xs tracking-wide uppercase', image.caption ? 'mt-1' : '']}>
                    Foto: {image.credit}
                  </p>
                )}
              </figcaption>
            )}
          </figure>
        ))
      }
    </div>
  </article>
</BaseLayout>
