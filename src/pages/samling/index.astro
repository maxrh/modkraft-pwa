---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/layout/Container.astro';
import PageHeader from '@/components/layout/PageHeader.astro';
import CollectionCard from '@/components/CollectionCard.astro';
import { getArchiveStats, sortCollectionsNewest } from '@/lib/photos';

const collections = (await getCollection('photoCollections')).sort(sortCollectionsNewest);
const series = await getCollection('photoSeries');
const { collectionCount } = await getArchiveStats();
const description = `Alle ${collectionCount} fotoseries og fotoblogs i Modkraft-arkivet.`;
---

<BaseLayout title="Samlinger" description={description}>
  <Container class="pt-8 pb-6">
    <PageHeader
      title="Samlinger"
      meta={`${collections.length} fotoseries og fotoblogs`}
      crumbs={[{ label: '← Tilbage til fotomosaik', href: '/' }]}
    >
      {
        series.length > 0 && (
          <div class="mt-6 flex flex-wrap gap-2">
            {series.map((s) => (
              <a
                href={`/serie/${s.data.id}`}
                class="rounded-full border border-border bg-card px-3.5 py-1.5 text-xs font-medium text-foreground no-underline hover:border-foreground/40"
              >
                Serie: {s.data.title}
              </a>
            ))}
          </div>
        )
      }
    </PageHeader>
  </Container>

  <Container class="pb-16">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {collections.map((collection) => <CollectionCard collection={collection} />)}
    </div>
  </Container>
</BaseLayout>
