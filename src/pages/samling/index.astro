---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CollectionCard from '@/components/CollectionCard.astro';
import { sortCollectionsNewest } from '@/lib/photos';

const collections = (await getCollection('photoCollections')).sort(sortCollectionsNewest);
const series = await getCollection('photoSeries');
---

<BaseLayout title="Samlinger" description="Alle 99 fotoseries og fotoblogs i Modkraft-arkivet.">
  <section class="mx-auto max-w-[1600px] px-4 pt-8 pb-6 sm:px-6">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <div>
        <h1 class="font-display text-3xl font-bold tracking-tight sm:text-4xl">Samlinger</h1>
        <p class="mt-1 text-muted-foreground">{collections.length} fotoseries og fotoblogs</p>
      </div>
      <a href="/" class="text-sm font-medium text-muted-foreground no-underline hover:text-foreground">
        ← Tilbage til fotomosaik
      </a>
    </div>

    {
      series.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-2">
          {series.map((s) => (
            <a
              href={`/serie/${s.data.id}`}
              class="rounded-full border border-border bg-card px-3.5 py-1.5 text-xs font-medium text-foreground no-underline hover:border-foreground/40"
            >
              Serie: {s.data.title}
            </a>
          ))}
        </div>
      )
    }
  </section>

  <section class="mx-auto max-w-[1600px] px-4 pb-16 sm:px-6">
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {collections.map((collection) => <CollectionCard collection={collection} />)}
    </div>
  </section>
</BaseLayout>
