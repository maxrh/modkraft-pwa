---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/layout/Container.astro';
import PhotoMosaic from '@/components/PhotoMosaic.astro';
import { getAllPhotos, slugifyTag, type Photo } from '@/lib/photos';

export async function getStaticPaths() {
  const photos = await getAllPhotos();
  const byTag = new Map<string, Photo[]>();

  for (const photo of photos) {
    for (const tag of photo.tags) {
      const list = byTag.get(tag) ?? [];
      list.push(photo);
      byTag.set(tag, list);
    }
  }

  const usedSlugs = new Map<string, string>();

  return [...byTag.entries()].map(([tag, tagPhotos]) => {
    const slug = slugifyTag(tag);
    const existing = usedSlugs.get(slug);
    if (existing && existing !== tag) {
      throw new Error(`Tag slug collision: "${existing}" and "${tag}" both map to "${slug}"`);
    }
    usedSlugs.set(slug, tag);

    return {
      params: { tag: slug },
      props: { tag, photos: tagPhotos },
    };
  });
}

interface Props {
  tag: string;
  photos: Photo[];
}

const { tag, photos } = Astro.props;
---

<BaseLayout
  title={tag}
  description={`${photos.length} fotos med tagget "${tag}".`}
  activeTag={tag}
>
  <Container class="pt-4 pb-16">
    <PhotoMosaic photos={photos} />
  </Container>
</BaseLayout>
