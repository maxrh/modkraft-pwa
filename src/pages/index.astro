---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/layout/Container.astro';
import ContentHeader from '@/components/layout/ContentHeader.astro';
import PhotoMosaic from '@/components/PhotoMosaic.astro';
import { getAllPhotos, getArchiveStats } from '@/lib/photos';

const photos = await getAllPhotos();
const { collectionCount } = await getArchiveStats();
const description = 'Dokumentariske fotografier fra Modkrafts fotoserier og fotoblogs 2012 - 2017';
---

<BaseLayout title="Modkraft Fotoarkiv" description={description}>
  <Container size="stage" class="pt-8 pb-16">
    <ContentHeader
      title="Modkraft Fotoarkiv"
      description={description}
      count={photos.length}
      seriesCount={collectionCount}
    />
    <PhotoMosaic photos={photos} sortable />
  </Container>
</BaseLayout>
