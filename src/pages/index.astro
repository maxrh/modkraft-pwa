---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/layout/Container.astro';
import PhotoMosaic from '@/components/PhotoMosaic.astro';
import { getAllPhotos, getArchiveStats } from '@/lib/photos';

const photos = await getAllPhotos();
const { photoCount } = await getArchiveStats();
const description = `${photoCount.toLocaleString('da-DK')} dokumentariske fotografier fra Modkrafts fotoserier og fotoblogs.`;
---

<BaseLayout title="Modkraft Arkiv" description={description}>
  <Container class="pt-8 pb-16">
    <PhotoMosaic photos={photos} />
  </Container>
</BaseLayout>
