---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PhotoMosaic from '@/components/PhotoMosaic.astro';
import { getAllPhotos } from '@/lib/photos';

const photos = await getAllPhotos();
---

<BaseLayout
  title="Modkraft Arkiv"
  description="1.641 dokumentariske fotografier fra Modkrafts fotoseries og fotoblogs."
>
  <section class="mx-auto max-w-[1600px] px-4 pt-4 pb-16 sm:px-6">
    <PhotoMosaic photos={photos} />
  </section>
</BaseLayout>
