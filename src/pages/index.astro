---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/layout/Container.astro';
import ContentHeader from '@/components/layout/ContentHeader.astro';
import ArchiveMosaics from '@/components/layout/ArchiveMosaics.astro';
import { collectionCardsFromPhotos, getAllPhotos, getArchiveStats } from '@/lib/photos';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/lib/site';

const photos = await getAllPhotos();
const collections = await getCollection('photoCollections');
const collectionCards = collectionCardsFromPhotos(photos, collections);
const { collectionCount } = await getArchiveStats();
---

<BaseLayout title={SITE_TITLE}>
  <Container class="pt-8 pb-16">
    <ContentHeader
      title={SITE_TITLE}
      description={SITE_DESCRIPTION}
      count={photos.length}
      seriesCount={collectionCount}
      showView
    />
    <ArchiveMosaics photos={photos} collections={collectionCards} />
  </Container>
</BaseLayout>
