---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/layout/Container.astro';
import ContentHero from '@/components/layout/ContentHero.astro';
import MosaicToolbar from '@/components/layout/MosaicToolbar.astro';
import ArchiveMosaics from '@/components/layout/ArchiveMosaics.astro';
import { renderMarkdown } from '@/lib/markdown';
import {
  collectionCardData,
  flattenCollectionPhotos,
  formatDate,
  sortCollectionsOldest,
  type CollectionCardData,
} from '@/lib/photos';

export async function getStaticPaths() {
  const allSeries = await getCollection('photoSeries');
  return allSeries.map((series) => ({
    params: { id: series.data.id },
    props: { series },
  }));
}

interface Props {
  series: CollectionEntry<'photoSeries'>;
}

const { series } = Astro.props;
const posts = (await getCollection('photoCollections'))
  .filter((c) => c.data.series === series.data.id)
  .sort(sortCollectionsOldest);

const seriesPhotos = posts.flatMap(flattenCollectionPhotos);
const collectionCards = posts
  .map((c) => collectionCardData(c))
  .filter((c): c is CollectionCardData => Boolean(c));
const aboutHtml = renderMarkdown(series.data.aboutSeries);
const viomisHtml = renderMarkdown(series.data.aboutViomis);
const authorHtml = renderMarkdown(series.data.aboutAuthor);
const hasAboutFooter = Boolean(viomisHtml || authorHtml);
const startedAt = posts[0]?.data.publishedAt;
const heroMeta = [`Af ${series.data.author}`, startedAt ? formatDate(startedAt) : null]
  .filter(Boolean)
  .join(' · ');
---

<BaseLayout title={series.data.title} description={series.data.intro}>
  <article>
    <Container class="pt-8">
      <ContentHero title={series.data.title} kicker="Fotoblog" meta={heroMeta} />
    </Container>

    {
      (series.data.intro || aboutHtml) && (
        <Container size="text" class="pt-4 pb-4">
          {series.data.intro && (
            <p class="text-lg text-muted-foreground">{series.data.intro}</p>
          )}
          {aboutHtml && (
            <div
              class:list={['prose prose-neutral max-w-none', series.data.intro && 'mt-6']}
              set:html={aboutHtml}
            />
          )}
        </Container>
      )
    }

    <Container class:list={['pt-16', !hasAboutFooter && 'pb-20']}>
      <MosaicToolbar
        count={seriesPhotos.length}
        seriesCount={collectionCards.length}
        showView
        showSort={false}
        defaultView="collections"
        persistView={false}
        class="mb-4"
      />
      <ArchiveMosaics
        photos={seriesPhotos}
        collections={collectionCards}
        defaultView="collections"
        sortable={false}
      />
    </Container>

    {
      hasAboutFooter && (
        <Container class="pt-20 pb-20">
          <section class="grid gap-8 border-t border-border pt-12 md:grid-cols-2 md:gap-16">
            {viomisHtml && (
              <div>
                <h2 class="font-display mb-3 text-xl font-semibold">Om VIOMIS</h2>
                <div class="prose prose-neutral max-w-none" set:html={viomisHtml} />
              </div>
            )}
            {authorHtml && (
              <div>
                <h2 class="font-display mb-3 text-xl font-semibold">Om fotografen</h2>
                <div class="prose prose-neutral max-w-none" set:html={authorHtml} />
              </div>
            )}
          </section>
        </Container>
      )
    }
  </article>
</BaseLayout>
