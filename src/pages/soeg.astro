---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Container from '@/components/layout/Container.astro';
import ContentHeader from '@/components/layout/ContentHeader.astro';
import PhotoMosaic from '@/components/PhotoMosaic.astro';
import { getAllPhotos, photoMatchesQuery } from '@/lib/photos';

export const prerender = false;

const q = Astro.url.searchParams.get('q')?.trim() ?? '';
const all = await getAllPhotos();
const photos = q ? all.filter((photo) => photoMatchesQuery(photo, q)) : all;
const seriesCount = new Set(photos.map((photo) => photo.collectionId)).size;
---

<BaseLayout
  title={q ? `Søg: ${q}` : 'Søg'}
  description={q ? `Søgeresultater for “${q}”.` : 'Søg i Modkraft-fotoarkivet.'}
  searchQuery={q}
>
  <Container class="pt-8 pb-16">
    {
      q && (
        <ContentHeader title={q} count={photos.length} seriesCount={seriesCount} />
      )
    }
    {
      photos.length > 0 ? (
        <PhotoMosaic photos={photos} sortable={Boolean(q)} />
      ) : (
        <p class="py-16 text-center text-muted-foreground">Ingen fotos matchede din søgning.</p>
      )
    }
  </Container>
</BaseLayout>
