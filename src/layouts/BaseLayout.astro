---
import { X } from 'lucide-react';
import '@/styles/global.css';
import Head from '@/components/layout/Head.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '@/lib/site';

interface Props {
  title?: string;
  description?: string;
  /** Currently selected tag filter (null/undefined = Alle). */
  activeTag?: string | null;
  /** Prefill the header search field. */
  searchQuery?: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  jsonLd?: Record<string, unknown>;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  activeTag = null,
  searchQuery = '',
  canonical,
  image,
  imageAlt,
  jsonLd,
} = Astro.props;
---

<!doctype html>
<html lang="da">
  <head>
    <Head
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      imageAlt={imageAlt}
      jsonLd={jsonLd}
    />
    <script src="../pwa.ts"></script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <SiteHeader activeTag={activeTag} searchQuery={searchQuery} />
    <main class="flex-1" transition:animate="none">
      <slot />
    </main>
    <SiteFooter />
    <dialog
      data-photo-modal
      aria-label="Indhold"
      class="m-0 h-dvh max-h-none w-screen max-w-none cursor-zoom-out overflow-y-auto overscroll-contain border-0 bg-transparent p-0 backdrop:bg-black/80"
    >
      <button
        type="button"
        data-photo-modal-close
        aria-label="Luk"
        class="fixed z-10 cursor-pointer p-0 leading-none text-white drop-shadow"
      >
        <X className="size-6" aria-hidden="true" />
      </button>
      <div
        data-photo-modal-panel
        class="mx-auto w-full max-w-[var(--modal-panel-max)] cursor-auto overflow-hidden bg-background sm:rounded-lg"
      >
        <div data-photo-modal-body></div>
      </div>
    </dialog>
    <script is:inline>
      (function () {
        var mk = (window.__mk = window.__mk || {});
        if (mk.photoModalBound) return;
        mk.photoModalBound = true;

        var requestId = 0;

        function modalDialog() {
          return document.querySelector('[data-photo-modal]');
        }

        function isOpen() {
          var dialog = modalDialog();
          return !!(dialog && dialog.open);
        }

        function modalHref(href) {
          try {
            var url = new URL(href, location.href);
            if (url.origin !== location.origin) return null;
            var path = url.pathname;
            if (/^\/foto\/[^/]+\/[^/]+\/?$/.test(path)) {
              return path + url.search + url.hash;
            }
            if (/^\/fotoserie\/[^/]+\/?$/.test(path)) {
              return path + url.search + url.hash;
            }
            return null;
          } catch (e) {
            return null;
          }
        }

        function modalKind(href) {
          try {
            var path = new URL(href, location.href).pathname;
            if (path.indexOf('/fotoserie/') === 0) return 'fotoserie';
            if (path.indexOf('/foto/') === 0) return 'foto';
          } catch (e) {}
          return null;
        }

        function lockScroll() {
          if (document.documentElement.hasAttribute('data-photo-modal-lock')) return;
          var sb = window.innerWidth - document.documentElement.clientWidth;
          document.documentElement.setAttribute('data-photo-modal-lock', '');
          if (sb > 0) document.body.style.paddingRight = sb + 'px';
          document.body.style.overflow = 'hidden';
        }

        function clearScrollLock() {
          document.documentElement.removeAttribute('data-photo-modal-lock');
          document.documentElement.removeAttribute('data-photo-modal-open');
          document.body.removeAttribute('data-scroll-locked');
          document.body.style.paddingRight = '';
          document.body.style.overflow = '';
        }

        function unlockScroll() {
          clearScrollLock();
          window.scrollTo(0, mk.photoModalScroll || 0);
        }

        function syncPhotoCaption(img) {
          if (!img) return;
          var open = img.closest('[data-photo-open]');
          var figure = img.closest('figure');
          var cap = figure && figure.querySelector('[data-photo-caption]');
          if (open) open.style.width = '';
          var w = img.clientWidth;
          if (!w) return;
          if (open) open.style.width = w + 'px';
          if (cap) cap.style.width = w + 'px';
        }
        mk.syncPhotoCaption = syncPhotoCaption;

        function syncPhotoCaptions(root) {
          var scope = root || document;
          var imgs = scope.querySelectorAll('[data-photo-open] img');
          for (var i = 0; i < imgs.length; i++) syncPhotoCaption(imgs[i]);
        }

        function revealSlides(root) {
          var imgs = root.querySelectorAll('[data-photo-slide] [data-photo-open] img');
          for (var i = 0; i < imgs.length; i++) {
            if (imgs[i].complete && imgs[i].naturalWidth) imgs[i].dataset.loaded = '';
            syncPhotoCaption(imgs[i]);
          }
        }

        function syncModalScrollbar() {
          var dialog = modalDialog();
          if (!dialog) return;
          var sb = dialog.offsetWidth - dialog.clientWidth;
          if (sb < 0) sb = 0;
          dialog.style.setProperty('--modal-sb', sb + 'px');
        }

        window.addEventListener('resize', function () {
          syncPhotoCaptions(document);
          syncModalScrollbar();
        });

        function wireLightbox(root) {
          var lightbox = root.querySelector('[data-photo-lightbox]');
          var openEl = root.querySelector('[data-photo-open]');
          if (!lightbox || !openEl) return;
          var lightboxImg = lightbox.querySelector('[data-photo-lightbox-img]');
          if (!lightboxImg) return;

          openEl.onclick = function () {
            var fullSrc = lightboxImg.getAttribute('data-full-src');
            if (fullSrc && lightboxImg.getAttribute('src') !== fullSrc) {
              lightboxImg.setAttribute('src', fullSrc);
            }
            if (typeof lightbox.showModal === 'function' && !lightbox.open) lightbox.showModal();
          };
          lightbox.onclick = function () {
            if (lightbox.open) lightbox.close();
          };
        }

        function initModalMosaics(root) {
          if (typeof mk.initMosaic === 'function') {
            var mosaics = root.querySelectorAll('[data-mosaic-root]:not([data-ready])');
            for (var i = 0; i < mosaics.length; i++) mk.initMosaic(mosaics[i]);
          }
          if (typeof mk.initCollectionMosaic === 'function') {
            var collections = root.querySelectorAll(
              '[data-collection-mosaic]:not([data-ready])',
            );
            for (var c = 0; c < collections.length; c++) mk.initCollectionMosaic(collections[c]);
          }
        }

        function hideModal() {
          var dialog = modalDialog();
          if (!dialog || !dialog.open) {
            clearScrollLock();
            return;
          }
          requestId++;
          var body = dialog.querySelector('[data-photo-modal-body]');
          if (body) body.replaceChildren();
          dialog.scrollTop = 0;
          dialog.close();
          if (mk.photoModalTitle) document.title = mk.photoModalTitle;
          mk.photoModalDepth = 0;
          mk.photoModalStack = [];
          mk.photoModalClosing = false;
          unlockScroll();
        }

        function loadModalContent(href, options) {
          var dialog = modalDialog();
          if (!dialog) {
            location.assign(href);
            return;
          }

          options = options || {};
          var writeHistory = options.writeHistory !== false;
          var opening = !dialog.open;

          if (opening) {
            mk.photoModalTitle = document.title;
            mk.photoModalScroll = window.scrollY || 0;
            mk.photoModalDepth = 0;
            mk.photoModalStack = [];
            mk.photoModalClosing = false;
          }

          if (writeHistory) {
            // Don't carry the grid's scrollY onto the modal URL. A full load of that
            // address (Enter in the address bar) would otherwise restore that scroll.
            var state = Object.assign({}, history.state || {}, {
              photoModal: true,
              scrollX: 0,
              scrollY: 0,
            });
            var stack = mk.photoModalStack || [];
            var replace = false;
            if (dialog.open) {
              var fromKind = modalKind(location.href);
              var toKind = modalKind(href);
              replace = Boolean(fromKind && toKind && fromKind === toKind);
            }
            if (replace) {
              history.replaceState(state, '', href);
              if (stack.length) stack[stack.length - 1] = href;
              else stack.push(href);
            } else if (stack.length >= 2 && stack[stack.length - 2] === href) {
              // Prev/next back to the previous modal entry — pop history instead of stacking.
              history.back();
              return;
            } else {
              history.pushState(state, '', href);
              stack.push(href);
              mk.photoModalDepth = stack.length;
            }
            mk.photoModalStack = stack;
          }

          document.documentElement.setAttribute('data-photo-modal-open', '');

          var id = ++requestId;
          fetch(href, { headers: { Accept: 'text/html' } })
            .then(function (res) {
              if (!res.ok) throw new Error('bad status');
              return res.text();
            })
            .then(function (html) {
              if (id !== requestId) return;
              var parsed = new DOMParser().parseFromString(html, 'text/html');
              var main = parsed.querySelector('main');
              var body = dialog.querySelector('[data-photo-modal-body]');
              if (!main || !body) throw new Error('no main');
              main.querySelectorAll('script').forEach(function (script) {
                var type = (script.getAttribute('type') || '').toLowerCase();
                if (type === 'application/json' || type === 'application/ld+json') return;
                script.remove();
              });
              body.replaceChildren();
              while (main.firstChild) body.appendChild(document.adoptNode(main.firstChild));
              var title = parsed.querySelector('title');
              if (title && title.textContent) document.title = title.textContent;
              if (opening && !dialog.open) {
                dialog.showModal();
                lockScroll();
              }
              // Reset after showModal — closed dialogs often ignore scrollTop.
              dialog.scrollTop = 0;
              syncModalScrollbar();
              revealSlides(body);
              wireLightbox(body);
              initModalMosaics(body);
            })
            .catch(function () {
              if (id !== requestId) return;
              location.assign(href);
            });
        }

        function openPhoto(href) {
          loadModalContent(href, { writeHistory: true });
        }

        function requestClose() {
          var depth = mk.photoModalDepth || 0;
          if (depth > 0 && history.state && history.state.photoModal) {
            mk.photoModalClosing = true;
            history.go(-depth);
            return;
          }
          hideModal();
        }

        document.addEventListener(
          'click',
          function (event) {
            if (event.defaultPrevented) return;
            if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
              return;
            }
            var dialog = modalDialog();
            if (!dialog) return;

            var closeBtn = event.target.closest('[data-photo-modal-close]');
            if (closeBtn && dialog.contains(closeBtn)) {
              event.preventDefault();
              requestClose();
              return;
            }

            if (event.target === dialog) {
              event.preventDefault();
              requestClose();
              return;
            }

            var link = event.target.closest('a[href]');
            if (!link) return;
            var isCard = link.hasAttribute('data-card-link');
            var isModalNav = link.hasAttribute('data-modal-link');
            // Cards always open in the modal; prev/next only while the modal is already open.
            // Parent SeriesNav title links stay normal page navigations.
            if (!isCard && !(isModalNav && dialog.open)) return;
            var href = modalHref(link.getAttribute('href'));
            if (!href) return;
            if (!dialog.open && location.pathname.indexOf('/foto/') === 0) return;

            event.preventDefault();
            event.stopPropagation();
            openPhoto(href);
          },
          true,
        );

        document.addEventListener(
          'cancel',
          function (event) {
            var dialog = event.target;
            if (!dialog || !dialog.hasAttribute || !dialog.hasAttribute('data-photo-modal')) return;
            event.preventDefault();
            requestClose();
          },
          true,
        );

        window.addEventListener(
          'popstate',
          function (event) {
            if (!isOpen()) return;
            event.stopImmediatePropagation();
            if (mk.photoModalClosing) {
              hideModal();
              return;
            }
            var href = modalHref(location.href);
            if (href) {
              var stack = mk.photoModalStack || [];
              if (stack.length) stack.pop();
              mk.photoModalStack = stack;
              mk.photoModalDepth = stack.length;
              loadModalContent(href, { writeHistory: false });
              return;
            }
            hideModal();
          },
          true,
        );

        document.addEventListener('astro:before-preparation', function () {
          hideModal();
        });

        // Body lock attrs persist across ClientRouter swaps.
        document.addEventListener('astro:after-swap', clearScrollLock);

        // Full load of the photo URL (Enter in the address bar) should start at the top.
        // Don't move the grid while the modal is open.
        window.addEventListener('pagehide', function () {
          if (!isOpen() || !history.state) return;
          history.replaceState(
            Object.assign({}, history.state, { scrollX: 0, scrollY: 0 }),
            '',
          );
        });

        syncPhotoCaptions(document);
      })();
    </script>
  </body>
</html>
