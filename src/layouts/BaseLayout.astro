---
import '@/styles/global.css';
import Head from '@/components/layout/Head.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  /** Currently selected tag filter (null/undefined = Alle). */
  activeTag?: string | null;
  /** Prefill the header search field. */
  searchQuery?: string;
  canonical?: string;
  image?: string;
  imageAlt?: string;
  jsonLd?: Record<string, unknown>;
}

const {
  title = 'Modkraft Fotoarkiv',
  description = 'Fotoarkiv fra Modkraft — dokumentariske fotoserier og fotoblogs.',
  activeTag = null,
  searchQuery = '',
  canonical,
  image,
  imageAlt,
  jsonLd,
} = Astro.props;
---

<!doctype html>
<html lang="da">
  <head>
    <Head
      title={title}
      description={description}
      canonical={canonical}
      image={image}
      imageAlt={imageAlt}
      jsonLd={jsonLd}
    />
  </head>
  <body class="flex min-h-dvh flex-col">
    <SiteHeader activeTag={activeTag} searchQuery={searchQuery} />
    <main class="flex-1" transition:animate="none">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
