---
import '@/styles/global.css';
import Head from '@/components/layout/Head.astro';
import SiteHeader from '@/components/layout/SiteHeader.astro';
import SiteFooter from '@/components/layout/SiteFooter.astro';

interface Props {
  title?: string;
  description?: string;
  /** Currently selected tag filter (null/undefined = Alle). */
  activeTag?: string | null;
  /** Prefill the header search field. */
  searchQuery?: string;
}

const {
  title = 'Modkraft Arkiv',
  description = 'Fotoarkiv fra Modkraft — dokumentariske fotoseries og fotoblogs.',
  activeTag = null,
  searchQuery = '',
} = Astro.props;
---

<!doctype html>
<html lang="da">
  <head>
    <Head title={title} description={description} />
  </head>
  <body class="flex min-h-dvh flex-col">
    <SiteHeader activeTag={activeTag} searchQuery={searchQuery} />
    <main class="flex-1" transition:animate="fade">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
